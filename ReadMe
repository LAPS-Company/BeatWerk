'use strict';
/* =====================================================================
   Beatwerk – Kern: Helfer, Datenmodell, Verlauf (Undo), Speicherung
   ===================================================================== */
const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => [...r.querySelectorAll(s)];
const SVGNS = 'http://www.w3.org/2000/svg';

function el(tag, attrs, ...kids) {
  const e = document.createElement(tag);
  if (attrs) for (const k in attrs) {
    const v = attrs[k];
    if (v == null || v === false) continue;
    if (k === 'class') e.className = v;
    else if (k === 'text') e.textContent = v;
    else if (k === 'style' && typeof v === 'object') { for (const p in v) { if (p.startsWith('--')) e.style.setProperty(p, v[p]); else e.style[p] = v[p]; } }
    else if (k.startsWith('on') && typeof v === 'function') e.addEventListener(k.slice(2), v);
    else e.setAttribute(k, v === true ? '' : v);
  }
  for (const c of kids.flat()) if (c != null && c !== false) e.append(c.nodeType ? c : document.createTextNode(c));
  return e;
}
function sv(tag, attrs) {
  const e = document.createElementNS(SVGNS, tag);
  if (attrs) for (const k in attrs) e.setAttribute(k, attrs[k]);
  return e;
}
const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
const lerp = (a, b, t) => a + (b - a) * t;
const NOTE_NAMES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
const noteName = m => NOTE_NAMES[m % 12] + Math.floor(m / 12);   // FL-Zählung: C5 = Mittel-C = MIDI 60
const isBlack = m => [1, 3, 6, 8, 10].includes(m % 12);
const mtof = m => 440 * Math.pow(2, (m - 69) / 12);
const STEP_BAR = 16;            // 16tel pro Takt (4/4)
const NUM_INS = 33;             // 0 = Master, 1..32 = Inserts
const NUM_SLOTS = 10;           // Effekt-Plätze je Insert
const NUM_TRACKS = 14;          // Playlist-Spuren
const AUTO_MAX_PTS = 400;       // Punkte je Automation-Clip
const AUTO_TG_RE = /^(ins:\d{1,2}:(vol|pan|lo|mid|hi|mf)|fx:\d{1,2}:\d{1,2}:[a-z]{2,8}|ch:\d{1,6}:(vol|pan))$/;
/** Automation-Punkte prüfen: {t: Step im Clip, v: 0..1}, nach Zeit sortiert, höchstens ein Punkt je Zeit */
function cleanAutoPts(pts, len) {
  const out = [];
  if (Array.isArray(pts)) for (const p of pts) if (p && isFinite(p.t) && isFinite(p.v)) out.push({ t: round3(clamp(+p.t, 0, len)), v: round3(clamp(+p.v, 0, 1)) });
  out.sort((a, b) => a.t - b.t);
  const res = []; for (const p of out) { if (res.length && Math.abs(res[res.length - 1].t - p.t) < 1e-6) res[res.length - 1] = p; else res.push(p); }
  if (res.length > AUTO_MAX_PTS) res.length = AUTO_MAX_PTS;
  return res.length ? res : [{ t: 0, v: .5 }, { t: len, v: .5 }];
}

let _uid = 1;
const uid = () => _uid++;
const round3 = v => Math.round(v * 1000) / 1000;

/* ---------- Pegel-Abbildungen ---------- */
const DB0 = 60 / 66;                                   // Fader-Position für 0 dB
const faderDb = pos => pos * 66 - 60;                   // Position 0..1  ->  -60..+6 dB
const dbGain = pos => pos < 0.004 ? 0 : Math.pow(10, faderDb(pos) / 20);
const chGain = v => v * v / 0.6084;                     // Kanal-Regler 0..1, 0.78 = 0 dB
const fmtDb = pos => pos < 0.004 ? '-∞ dB' : faderDb(pos).toFixed(1) + ' dB';


  function generateDemoCard(){let n=pick(demoCardNames);if(n===demoCardName)n=demoCardNames[(demoCardNames.indexOf(n)+1)%demoCardNames.length];demoCardName=n;demoCardNumber=makeDemoCardNumber();demoCardExpiry=makeDemoExpiry();demoCardCvv=makeDemoCvv();updateDemoCard();}
  generateDemoCard();
  $('cardNewDemo').addEventListener('click',generateDemoCard);
  $('demoCopyNumber').addEventListener('click',()=>copyText(demoCardNumber,'Invalid demo number copied'));
  $('demoCopyName').addEventListener('click',()=>copyText(demoCardName,'Demo name copied'));
  $('demoCopyExpiry').addEventListener('click',()=>copyText(demoCardExpiry,'Demo expiry copied'));
  $('demoCopyCvv').addEventListener('click',()=>copyText(demoCardCvv,'Demo security code copied'));
  $('demoCopyAll').addEventListener('click',()=>copyText(`CARD NUMBER: ${demoCardNumber}\nCARDHOLDER: ${demoCardName}\nEXPIRY: ${demoCardExpiry}\nSECURITY CODE: ${demoCardCvv} (DEMO ONLY, NOT VALID)`,'All demo data copied'));

  // URL Shortener: is.gd supports optional custom aliases via its documented shorturl parameter.
  // The destination URL and custom alias are sent to is.gd; do not use private links or aliases containing secrets.
  let shortenerBusy=false;
  function setShortenerMessage(message,kind=''){const el=$('shortUrlMessage');el.className='result-info'+(kind?' '+kind:'');el.textContent=message;}
  function shortenerCleanup(script,callback,timer){clearTimeout(timer);if(script&&script.parentNode)script.parentNode.removeChild(script);try{delete window[callback];}catch(_){window[callback]=undefined;}}
  function runUrlShortener(){
    if(shortenerBusy)return;
    const raw=$('shortUrlInput').value.trim();let parsed;
    try{parsed=new URL(raw);if(!['http:','https:'].includes(parsed.protocol))throw new Error('Only http:// and https:// links are supported.');}
    catch(e){setShortenerMessage(e.message==='Only http:// and https:// links are supported.'?e.message:'Enter a complete valid URL, including https://.','bad');return;}
    const alias=$('shortUrlAlias').value.trim();
    if(alias&&!/^[A-Za-z0-9_]{5,30}$/.test(alias)){setShortenerMessage('Custom alias must be 5–30 characters using only letters, numbers, and underscores.','bad');$('shortUrlAlias').focus();return;}
    shortenerBusy=true;$('shortenUrlBtn').disabled=true;$('shortenUrlBtn').textContent='Creating link…';setShortenerMessage(alias?'Requesting your custom link from is.gd…':'Contacting is.gd to create your short link…');$('shortUrlResultWrap').hidden=true;$('shortUrlResultEmpty').hidden=false;
    const callback='lapsShorten_'+Date.now()+'_'+Math.random().toString(36).slice(2,10);const script=document.createElement('script');let finished=false;
    const finish=(fn,value)=>{if(finished)return;finished=true;shortenerCleanup(script,callback,timer);shortenerBusy=false;$('shortenUrlBtn').disabled=false;$('shortenUrlBtn').textContent='✦ Shorten URL';fn(value);};
    const timer=setTimeout(()=>finish(err=>setShortenerMessage(err.message,'bad'),new Error('The shortening service did not respond in time. Check your connection and try again.')),18000);
    window[callback]=(data)=>{
      if(data&&data.shorturl){
        try{const short=new URL(data.shorturl);if(short.protocol!=='https:'||short.hostname!=='is.gd')throw new Error('The service returned an unexpected link.');
          finish(url=>{$('shortUrlResult').href=url;$('shortUrlResult').textContent=url;$('shortUrlResultWrap').hidden=false;$('shortUrlResultEmpty').hidden=true;setShortenerMessage(alias?'Custom short link created. Copy it or open it to check the destination.':'Short link created. Copy it or open it to check the destination.','good');},short.href);
        }catch(e){finish(err=>setShortenerMessage(err.message,'bad'),e);}
      }else{const msg=data&&data.errormessage?data.errormessage:'The service could not shorten this URL.';finish(err=>setShortenerMessage(err.message,'bad'),new Error(msg));}
    };
    script.onerror=()=>finish(err=>setShortenerMessage(err.message,'bad'),new Error('Could not reach is.gd. Check your internet connection or try again later.'));
    script.src='https://is.gd/create.php?format=json&callback='+encodeURIComponent(callback)+'&url='+encodeURIComponent(parsed.href)+(alias?'&shorturl='+encodeURIComponent(alias):'');document.head.appendChild(script);
  }
  $('shortenUrlBtn').addEventListener('click',runUrlShortener);
  ['shortUrlInput','shortUrlAlias'].forEach(id=>$(id).addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();runUrlShortener();}}));
  $('shortUrlClear').addEventListener('click',()=>{$('shortUrlInput').value='';$('shortUrlAlias').value='';$('shortUrlResultWrap').hidden=true;$('shortUrlResultEmpty').hidden=false;setShortenerMessage('Paste a complete http:// or https:// link to begin.');});
  $('shortUrlCopy').addEventListener('click',()=>copyText($('shortUrlResult').href,'Short link copied'));
  $('shortUrlOpen').addEventListener('click',()=>{const href=$('shortUrlResult').href;if(href)window.open(href,'_blank','noopener,noreferrer');});


  // Initial render
  generatePalette();renderMarkdown();updateTextStats();updateB64Labels();runHtmlPreview();updatePyLines();runRegex();updateGradient();updateFCStats();updateUnitOptions();$('dateStart').value=isoToday();$('dateEnd').value=isoToday();$('dateBase').value=isoToday();calculateDate();updateDocPreview();generatePassword();updateHexColor();updateDummyStats();convertUrl();
})();
</script>

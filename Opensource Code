  // Unicode-safe Base64
  let b64Mode='encode';
  function bytesToBinary(bytes){let s='';for(let i=0;i<bytes.length;i+=0x8000)s+=String.fromCharCode(...bytes.subarray(i,Math.min(i+0x8000,bytes.length)));return s;}
  function toBase64(str,urlSafe){let encoded=btoa(bytesToBinary(new TextEncoder().encode(str)));return urlSafe?encoded.replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,''):encoded;}
  function fromBase64(str,urlSafe){let clean=str.replace(/\s/g,'');if(urlSafe)clean=clean.replace(/-/g,'+').replace(/_/g,'/');clean=clean.replace(/[^A-Za-z0-9+/=]/g,'');while(clean.length%4)clean+='=';const binary=atob(clean);const bytes=Uint8Array.from(binary,c=>c.charCodeAt(0));return new TextDecoder('utf-8',{fatal:true}).decode(bytes);}
  function updateB64Labels(){const enc=b64Mode==='encode';$('b64ModeEncode').classList.toggle('active',enc);$('b64ModeDecode').classList.toggle('active',!enc);$('b64InputLabel').textContent=enc?'Plain text':'Base64 input';$('b64OutputLabel').textContent=enc?'Base64 output':'Decoded text';$('b64Input').placeholder=enc?'Enter text to encode...':'Paste Base64 text to decode...';$('b64Convert').textContent=enc?'→':'←';$('b64Message').textContent=enc?'Enter your text and select Convert.':'Paste Base64 text and select Convert.';}
  $('b64ModeEncode').addEventListener('click',()=>{b64Mode='encode';updateB64Labels();});$('b64ModeDecode').addEventListener('click',()=>{b64Mode='decode';updateB64Labels();});
  function runB64(){const src=$('b64Input').value; const urlSafe=$('b64UrlSafe').checked; $('b64InStats').textContent=src.length.toLocaleString()+' characters';try{const out=b64Mode==='encode'?toBase64(src,urlSafe):fromBase64(src,urlSafe);$('b64Output').value=out;$('b64OutStats').textContent=out.length.toLocaleString()+' characters';$('b64Message').className='result-info good';$('b64Message').textContent=(b64Mode==='encode'?'Encoded':'Decoded')+' successfully.';}catch(e){$('b64Output').value='';$('b64OutStats').textContent='No output';$('b64Message').className='result-info bad';$('b64Message').textContent='Could not decode this input. Check that it is valid Base64 containing UTF-8 text.';}}
  $('b64Convert').addEventListener('click',runB64);$('b64Input').addEventListener('input',()=>{$('b64InStats').textContent=$('b64Input').value.length.toLocaleString()+' characters';});$('b64Copy').addEventListener('click',()=>{$('b64Output').value?copyText($('b64Output').value,'Output copied'):toast('Nothing to copy yet');});$('b64Clear').addEventListener('click',()=>{$('b64Input').value='';$('b64Output').value='';$('b64InStats').textContent='0 characters';$('b64OutStats').textContent='No output yet';updateB64Labels();});$('b64PasteSample').addEventListener('click',()=>{$('b64Input').value=b64Mode==='encode'?'Hello from LAPS Toolbox ✦':'SGVsbG8gZnJvbSBMQVBTIFRvb2xib3gh';runB64();});
  // Color palette generator
  const locked=[false,false,false,false,false];let palette=[];function rand(min,max){return Math.floor(Math.random()*(max-min+1))+min;}function hslToHex(h,s,l){s/=100;l/=100;const k=n=>(n+h/30)%12;const a=s*Math.min(l,1-l);const f=n=>l-a*Math.max(-1,Math.min(k(n)-3,Math.min(9-k(n),1)));return '#'+[f(0),f(8),f(4)].map(v=>Math.round(255*v).toString(16).padStart(2,'0')).join('').toUpperCase();}function hexToRgb(hex){const n=parseInt(hex.slice(1),16);return {r:(n>>16)&255,g:(n>>8)&255,b:n&255};}
  function generatePalette(){const mode=$('paletteMode').value;const base=rand(0,359);const s=rand(48,78);const l=rand(40,66);let hues=[];if(mode==='analogous')hues=[base-40,base-20,base,base+20,base+40];else if(mode==='complementary')hues=[base,base+180,base+160,base+200,base+20];else if(mode==='triadic')hues=[base,base+120,base+240,base+8,base+188];else if(mode==='monochrome')hues=[base,base,base,base,base];else hues=Array.from({length:5},()=>rand(0,359));palette=hues.map((h,i)=>locked[i]&&palette[i]?palette[i]:hslToHex((h+360)%360,mode==='monochrome'?s:rand(Math.max(25,s-15),Math.min(90,s+10)),mode==='monochrome'?[30,42,53,64,76][i]:rand(36,68)));renderPalette();$('paletteDescription').textContent=({random:'An eclectic, high-contrast mix of hues for a bold creative direction.',analogous:'Neighboring hues sit comfortably together for a calm, cohesive look.',complementary:'Opposing hues add contrast and make calls to action stand out.',triadic:'Three evenly spaced hues create a colorful but balanced combination.',monochrome:'One hue, explored across different brightness levels, for a refined tonal system.'})[mode];$('paletteMessage').textContent='New palette generated. Click a swatch to copy its HEX value.';}
  function renderPalette(){const bar=$('paletteBar');bar.innerHTML='';palette.forEach((hex,i)=>{const rgb=hexToRgb(hex);const lum=(.2126*rgb.r+.7152*rgb.g+.0722*rgb.b)/255;const el=document.createElement('button');el.className='swatch';el.style.background=hex;el.style.color=lum>.57?'#11141a':'#ffffff';el.setAttribute('aria-label','Copy color '+hex);el.innerHTML=`<span class="swatch-copy">${locked[i]?'⌑':'▢'}</span><span class="swatch-color">${hex}</span><span class="swatch-label">COLOR 0${i+1}${locked[i]?' · LOCKED':''}</span>`;el.addEventListener('click',()=>copyText(hex,'Copied '+hex));bar.appendChild(el);});}
  $('paletteGenerate').addEventListener('click',generatePalette);$('paletteMode').addEventListener('change',generatePalette);$('paletteLock').addEventListener('click',()=>{const lockAll=!locked.every(Boolean);for(let i=0;i<locked.length;i++)locked[i]=lockAll;$('paletteLock').textContent=lockAll?'⌑ Unlock all':'⌑ Lock all';renderPalette();toast(lockAll?'All colors locked':'Palette unlocked');});$('paletteExport').addEventListener('click',()=>{const css=':root {\n'+palette.map((hex,i)=>`  --laps-color-${i+1}: ${hex};`).join('\n')+'\n}\n';copyText(css,'CSS variables copied');});
  // Minimal safe markdown renderer
  function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');}
  function inlineMd(s){let t=esc(s);t=t.replace(/`([^`]+)`/g,'<code>$1</code>');t=t.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+|mailto:[^\s)]+)\)/g,'<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');t=t.replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>').replace(/__(.+?)__/g,'<strong>$1</strong>').replace(/~~(.+?)~~/g,'<del>$1</del>').replace(/\*(.+?)\*/g,'<em>$1</em>').replace(/_(.+?)_/g,'<em>$1</em>');return t;}
  function renderMd(src){const lines=src.replace(/\r/g,'').split('\n');let out='',para=[],ul=false,ol=false,quote=false,inCode=false,code=[];const closeLists=()=>{if(ul){out+='</ul>';ul=false;}if(ol){out+='</ol>';ol=false;}};const flushPara=()=>{if(para.length){out+='<p>'+para.map(inlineMd).join('<br>')+'</p>';para=[];}};const closeQuote=()=>{if(quote){out+='</blockquote>';quote=false;}};for(let i=0;i<lines.length;i++){const line=lines[i];if(/^\s*```/.test(line)){flushPara();closeLists();closeQuote();if(!inCode){inCode=true;code=[];}else{out+='<pre><code>'+esc(code.join('\n'))+'</code></pre>';inCode=false;}continue;}if(inCode){code.push(line);continue;}if(!line.trim()){flushPara();closeLists();closeQuote();continue;}let m;if((m=line.match(/^\s*(#{1,6})\s+(.+)$/))){flushPara();closeLists();closeQuote();const lvl=m[1].length;out+=`<h${lvl}>${inlineMd(m[2])}</h${lvl}>`;continue;}if(/^\s*(---+|\*\*\*+|___+)\s*$/.test(line)){flushPara();closeLists();closeQuote();out+='<hr>';continue;}if((m=line.match(/^\s*>\s?(.*)$/))){flushPara();closeLists();if(!quote){out+='<blockquote>';quote=true;}out+='<p>'+inlineMd(m[1])+'</p>';continue;}closeQuote();if((m=line.match(/^\s*[-*+]\s+(.+)$/))){flushPara();if(ol){out+='</ol>';ol=false;}if(!ul){out+='<ul>';ul=true;}out+='<li>'+inlineMd(m[1])+'</li>';continue;}if((m=line.match(/^\s*\d+[.)]\s+(.+)$/))){flushPara();if(ul){out+='</ul>';ul=false;}if(!ol){out+='<ol>';ol=true;}out+='<li>'+inlineMd(m[1])+'</li>';continue;}closeLists();para.push(line);}if(inCode)out+='<pre><code>'+esc(code.join('\n'))+'</code></pre>';flushPara();closeLists();closeQuote();return out||'<p style="color:#737d93;font-style:italic">Your preview will appear here...</p>';}
  function renderMarkdown(){const raw=$('mdInput').value;$('mdPreview').innerHTML=renderMd(raw);const words=raw.trim()?raw.trim().split(/\s+/).length:0;$('mdStats').textContent=words.toLocaleString()+' words · '+raw.length.toLocaleString()+' characters';$('mdPreviewStats').textContent=raw.trim()?'Preview updated':'Empty document';}
  $('mdInput').addEventListener('input',renderMarkdown);$('mdSample').addEventListener('click',()=>{$('mdInput').value='# Welcome to LAPS Toolbox\n\nA **simple** toolkit for your everyday workflow.\n\n## What you can do\n\n- Format and validate JSON\n- Generate useful color palettes\n- Turn text into a QR code\n\nUse `inline code` for commands, or add a link to [LAPS](https://example.com).\n\n> Made for creators, developers, and curious minds.\n\n---\n\n```js\nconst toolbox = "useful";\nconsole.log(toolbox);\n```';renderMarkdown();});$('mdCopy').addEventListener('click',()=>copyText($('mdInput').value,'Markdown copied'));$('mdClear').addEventListener('click',()=>{$('mdInput').value='';renderMarkdown();});
  // QR generator - QRCode.js external library
  let qrInstance=null;function qrMessage(msg,type=''){ $('qrMessage').className='result-info'+(type?' '+type:'');$('qrMessage').textContent=msg; }
  function generateQR(){const value=$('qrText').value.trim();const size=parseInt($('qrSize').value,10)||220;const levelKey=$('qrLevel').value; $('qrCharCount').textContent=$('qrText').value.length+' characters';if(!value){qrMessage('Enter a URL or some text first.','bad');return;}if(typeof QRCode==='undefined'){qrMessage('QR library could not load. Connect to the internet and reload this page, then try again.','bad');return;}const box=$('qrBox');box.innerHTML='';$('qrDownload').disabled=true;try{const levels={L:QRCode.CorrectLevel.L,M:QRCode.CorrectLevel.M,Q:QRCode.CorrectLevel.Q,H:QRCode.CorrectLevel.H};qrInstance=new QRCode(box,{text:value,width:size,height:size,colorDark:'#0b0d12',colorLight:'#ffffff',correctLevel:levels[levelKey]||QRCode.CorrectLevel.M});setTimeout(()=>{const cnv=box.querySelector('canvas'),img=box.querySelector('img');if(cnv||img){$('qrDownload').disabled=false;$('qrPreviewCaption').innerHTML='QR code ready. Scan with a phone camera to open the content.';qrMessage('QR code generated successfully.','good');}else{qrMessage('The QR code could not be generated. Try shorter text or lower error correction.','bad');}},120);}catch(err){qrMessage('Could not generate the QR code. Try a shorter input or lower error correction.','bad');}}

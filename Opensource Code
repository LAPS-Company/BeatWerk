.form-card{border:1px solid var(--line);background:rgba(255,255,255,.018);border-radius:14px;padding:16px;min-width:0}
.form-card h3{margin:0 0 12px;font-size:13px}
.form-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.form-row.three{grid-template-columns:repeat(3,minmax(0,1fr))}
.field-label{display:block;font-size:11px;font-weight:700;color:#a8b0c4;margin:0 0 7px}
.field,.select,.text-area{width:100%;min-width:0;border:1px solid rgba(255,255,255,.1);border-radius:10px;background:#0c0f16;color:var(--text);padding:10px 12px;font-size:12px}
.text-area{resize:vertical;min-height:150px;line-height:1.65}
.text-area:focus,.field:focus,.select:focus{border-color:rgba(167,139,250,.5);outline:none}
.check-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;color:#bec4d5;font-size:12px;margin:10px 0}
.check-row input{accent-color:#a78bfa}
.result-box{border:1px solid var(--line);border-radius:12px;background:#0b0e14;padding:15px;overflow:auto;min-height:58px;white-space:pre-wrap;word-break:break-word;color:#e0e5f3;font-size:12px}
.result-box.big{font-size:19px;letter-spacing:.3px;line-height:1.7}
.hint{color:var(--muted);font-size:11px;line-height:1.7;margin-top:9px}
.preview-paper{background:#fff;color:#202431;border-radius:12px;min-height:260px;padding:28px;line-height:1.75;white-space:pre-wrap;overflow-wrap:anywhere}
.preview-paper h2{margin-top:0;color:#202431}
.tool-card[hidden]{display:none!important}
@media(max-width:850px){.converter-grid,.unit-grid,.date-grid,.doc-grid{grid-template-columns:1fr}.form-row.three{grid-template-columns:1fr 1fr}}
@media(max-width:580px){.form-row,.form-row.three{grid-template-columns:1fr}.preview-paper{padding:18px}}


/* LAPS Toolbox v1.6: downloadable playground projects; obsolete packaging tool removed */
.new-tool-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.78fr);gap:18px;align-items:start}
.wifi-preview-card,.hex-preview-card,.dummy-preview-card{border:1px solid var(--line);border-radius:18px;background:linear-gradient(145deg,rgba(167,139,250,.07),rgba(255,255,255,.015));padding:20px;min-width:0}
.wifi-preview-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:18px}
.qr-big-box{min-height:285px;display:grid;place-items:center;background:#fff;border-radius:16px;padding:18px;margin:0 auto 14px;width:min(100%,320px);box-shadow:0 18px 48px rgba(0,0,0,.22)}
.qr-big-box canvas,.qr-big-box img{display:block;max-width:100%;height:auto!important;width:auto!important;image-rendering:pixelated}
.qr-big-box .qr-placeholder{color:#9ca3af;display:grid;place-items:center;gap:8px;text-align:center}.qr-big-box .qr-sym{font-size:46px}
.url-output-card{border:1px solid rgba(100,215,242,.17);border-radius:13px;background:linear-gradient(135deg,rgba(100,215,242,.07),rgba(167,139,250,.035));padding:16px;min-width:0}
.url-output{font:12px/1.8 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;color:#b8f1fb;min-height:100px;margin:10px 0}
.hex-stage{height:190px;border-radius:16px;border:1px solid rgba(255,255,255,.12);background:#a78bfa;position:relative;overflow:hidden;box-shadow:inset 0 0 0 1px rgba(0,0,0,.08)}
.hex-stage:after{content:'LAPS COLOR LAB';position:absolute;right:15px;bottom:12px;color:rgba(255,255,255,.7);font-size:10px;font-weight:800;letter-spacing:2px;text-shadow:0 1px 7px rgba(0,0,0,.35)}
.hex-color-input{width:100%;height:54px;border:0;padding:4px;border-radius:10px;background:#0c0f16;cursor:pointer}
.color-value-row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 12px;border:1px solid var(--line);background:rgba(0,0,0,.14);border-radius:10px;margin-top:9px;min-width:0}
.color-value-row code{font:12px ui-monospace,SFMono-Regular,Consolas,monospace;color:#f0edff;overflow-wrap:anywhere}
.dummy-output{width:100%;min-height:270px;font:11px/1.65 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre;overflow:auto;tab-size:2}
.dummy-tile-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:12px}
.dummy-tile{border:1px solid var(--line);border-radius:10px;padding:12px;background:rgba(255,255,255,.025);min-width:0}.dummy-tile strong{display:block;font-size:17px;letter-spacing:-.5px}.dummy-tile span{display:block;font-size:10px;color:var(--muted);margin-top:3px}
.card-demo-wrap{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(275px,.9fr);gap:22px;align-items:center}
.demo-payment-card{position:relative;overflow:hidden;isolation:isolate;aspect-ratio:1.586;border-radius:22px;padding:24px;color:#fff;background:radial-gradient(circle at 85% 15%,rgba(115,226,244,.27),transparent 27%),radial-gradient(circle at 18% 110%,rgba(167,139,250,.5),transparent 42%),linear-gradient(135deg,#28233f,#151925 54%,#172c3a);border:1px solid rgba(255,255,255,.22);box-shadow:0 25px 60px rgba(0,0,0,.35);display:flex;flex-direction:column;justify-content:space-between;min-width:0}
.demo-payment-card:before,.demo-payment-card:after{content:'';position:absolute;z-index:-1;border:1px solid rgba(255,255,255,.095);border-radius:50%;width:300px;height:300px;right:-100px;top:-160px;box-shadow:0 0 0 28px rgba(255,255,255,.025),0 0 0 60px rgba(255,255,255,.02)}
.demo-payment-card:after{width:220px;height:220px;left:-130px;right:auto;top:auto;bottom:-155px}
.demo-card-top,.demo-card-bottom{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;position:relative;z-index:1}
.demo-bank{font-size:11px;letter-spacing:2.3px;font-weight:850}.demo-card-label{display:inline-flex;align-items:center;gap:6px;border:1px solid rgba(255,255,255,.25);background:rgba(255,255,255,.08);padding:5px 8px;border-radius:999px;font-size:8px;font-weight:850;letter-spacing:1.1px}
.demo-chip{width:43px;height:33px;border-radius:8px;background:linear-gradient(135deg,#f9e7a9,#b4a16a 50%,#efe2b7);border:1px solid rgba(255,255,255,.6);position:relative;margin-top:21px;box-shadow:inset 0 0 0 1px rgba(93,72,32,.2)}.demo-chip:before,.demo-chip:after{content:'';position:absolute;background:rgba(110,89,45,.4)}.demo-chip:before{left:0;right:0;top:10px;height:1px}.demo-chip:after{top:0;bottom:0;left:15px;width:1px;box-shadow:12px 0 0 rgba(110,89,45,.4)}
.demo-card-number{font:clamp(15px,2.3vw,22px)/1.3 ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:1.25px;text-shadow:0 2px 8px rgba(0,0,0,.25);margin:20px 0 23px;position:relative;z-index:1;overflow-wrap:anywhere}
.demo-card-bottom{align-items:flex-end}.demo-card-holder-label{font-size:8px;color:#c9c9dc;letter-spacing:1.5px}.demo-card-holder{font-size:12px;font-weight:750;letter-spacing:.8px;text-transform:uppercase;margin-top:4px;overflow-wrap:anywhere}.demo-card-valid{font-size:8px;color:#c9c9dc;letter-spacing:1px}.demo-card-expiry{font:12px ui-monospace,SFMono-Regular,Consolas,monospace;margin-top:4px}.demo-orbit-logo{font-weight:950;font-size:22px;letter-spacing:-2px;font-style:italic}
.copy-data-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center;border:1px solid var(--line);background:rgba(255,255,255,.02);border-radius:11px;padding:12px;margin-top:9px;min-width:0}.copy-data-row small{display:block;color:var(--muted);font-size:9px;letter-spacing:1.3px;font-weight:800;margin-bottom:4px}.copy-data-row code{font:12px ui-monospace,SFMono-Regular,Consolas,monospace;overflow-wrap:anywhere;color:#f3f0ff}
.card-warning{border:1px solid rgba(255,193,141,.2);border-radius:12px;background:rgba(255,193,141,.055);padding:12px 14px;color:#f7cfa8;font-size:11px;line-height:1.65}
.tool-number-badge{display:inline-flex;align-items:center;justify-content:center;background:rgba(167,139,250,.1);border:1px solid rgba(167,139,250,.18);border-radius:8px;height:26px;min-width:30px;padding:0 7px;color:#cbbdff;font-size:10px;font-weight:800}
@media(max-width:900px){.new-tool-grid,.card-demo-wrap{grid-template-columns:1fr}.qr-big-box{min-height:240px}}
@media(max-width:580px){.dummy-tile-grid{grid-template-columns:1fr 1fr}.demo-payment-card{padding:18px;border-radius:17px}.demo-card-number{font-size:14px;letter-spacing:.7px;margin:14px 0 18px}.wifi-preview-card,.hex-preview-card,.dummy-preview-card{padding:14px}.new-tool-grid{gap:12px}}


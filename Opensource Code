/* ---------- Kacheldiagramm (Squarified Treemap) ---------- */
function squarify(values, W, H) {
  const total = values.reduce((a, v) => a + v, 0);
  if (!total || W <= 0 || H <= 0) return values.map(() => ({ x: 0, y: 0, w: 0, h: 0 }));
  const scale = (W * H) / total;
  const areas = values.map((v) => v * scale);
  const rects = new Array(values.length);
  const worst = (row, side) => {
    let s = 0, mx = 0, mn = Infinity;
    for (const r of row) { s += r.a; if (r.a > mx) mx = r.a; if (r.a < mn) mn = r.a; }
    return Math.max((side * side * mx) / (s * s), (s * s) / (side * side * mn));
  };
  let x = 0, y = 0, w = W, h = H, i = 0;
  while (i < areas.length) {
    const side = Math.min(w, h);
    let row = [{ a: areas[i], i }];
    let j = i + 1;
    while (j < areas.length) {
      const cand = row.concat([{ a: areas[j], i: j }]);
      if (worst(cand, side) <= worst(row, side)) { row = cand; j++; } else break;
    }
    const s = row.reduce((a, r) => a + r.a, 0);
    if (w >= h) {
      const cw = s / h;
      let cy = y;
      for (const r of row) { const rh = r.a / cw; rects[r.i] = { x, y: cy, w: cw, h: rh }; cy += rh; }
      x += cw; w -= cw;
    } else {
      const rh = s / w;
      let cx = x;
      for (const r of row) { const rw = r.a / rh; rects[r.i] = { x: cx, y, w: rw, h: rh }; cx += rw; }
      y += rh; h -= rh;
    }
    i = j;
  }
  return rects;
}


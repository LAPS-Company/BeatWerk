    coll = new Intl.Collator(currentLanguage === 'de' ? 'de' : 'en', {numeric:true,sensitivity:'base'});
    try { localStorage.setItem('laps-fileforge-language',currentLanguage); } catch(e) {}
    translateCurrentDOM(); renderActive(); translateCurrentDOM();
  };
  $('themeToggle').onclick = () => {
    document.documentElement.dataset.theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem('laps-fileforge-theme',document.documentElement.dataset.theme); } catch(e) {}
    translateCurrentDOM();
  };
  translateCurrentDOM();
  const observer = new MutationObserver(() => translateCurrentDOM());
  observer.observe(document.body,{subtree:true,childList:true,characterData:true});
}

function init() {
  wireTabs(); wireSource(); wireRename(); wireSort(); wireStruct(); wireList(); wireDup(); wireAnalyze(); wireSystem();
  renderSortMap();
  loadSample();
  let t = 'rename';
  try { const s = sessionStorage.getItem('ff-tab'); if (TABS.includes(s)) t = s; } catch (e) { /* ignorieren */ }
  setTab(t);
  initPreferences();
}
init();

</script>

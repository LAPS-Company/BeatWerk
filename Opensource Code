  function jsonRun(mode) { const raw=$('jsonInput').value; $('jsonInputStats').textContent=raw.length.toLocaleString()+' characters'; if(!raw.trim()){jsonStatus('Waiting for input',false);$('jsonOutput').innerHTML='<span class="empty-output">Your formatted JSON will appear here.</span>';$('jsonOutputStats').textContent='No output yet';jsonMessage('Paste JSON to get started.');return;} try {const obj=JSON.parse(raw); let out=mode==='minify'?JSON.stringify(obj):JSON.stringify(obj,null,2); $('jsonOutput').textContent=out; $('jsonOutputStats').textContent=out.length.toLocaleString()+' characters';jsonStatus('Valid JSON',true);jsonMessage(mode==='validate'?'Your JSON is valid.':mode==='minify'?'JSON minified successfully.':'JSON formatted successfully.','good');} catch(err){$('jsonOutput').innerHTML='<span class="empty-output">No output — fix the JSON error first.</span>';$('jsonOutputStats').textContent='Invalid input';jsonStatus('Invalid JSON',false,true);jsonMessage('Invalid JSON: '+err.message,'bad');} }

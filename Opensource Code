  catch (e) { if (e && e.name !== 'AbortError') toast('Ordnerauswahl nicht möglich: ' + e.message); return; }
  state.busy = true; renderActive();
  let made = 0, kept = 0;
  try {
    for (let i = 0; i < items.length; i++) {
      const it = items[i];

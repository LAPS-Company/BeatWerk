  function setTool(tool) { if (!names[tool]) tool='home'; currentTool=tool; document.querySelectorAll('.view').forEach(v=>v.classList.add('hidden')); $('view-'+tool).classList.remove('hidden'); document.querySelectorAll('.nav-btn').forEach(b=>b.classList.toggle('active',b.dataset.tool===tool)); $('crumbCurrent').textContent=names[tool]; $('sidebar').classList.remove('open'); $('toolSearch').value=''; filterTools(''); window.scrollTo({top:0,behavior:'smooth'}); if(tool==='markdown') renderMarkdown(); if(tool==='text') updateTextStats(); if(tool==='html') runHtmlPreview(); if(tool==='regex') runRegex(); if(tool==='gradient') updateGradient(); if(tool==='python') updatePyLines(); if(tool==='units') updateUnitOptions(); if(tool==='dates') calculateDate(); if(tool==='docpdf') updateDocPreview(); if(tool==='hexcolor') updateHexColor(); if(tool==='dummy') updateDummyStats(); if(tool==='carddemo') updateDemoCard(); }

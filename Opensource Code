<body>
<header class="top">
  <div class="brand">
    <img class="mark" src="data:image/png;base64," alt="" aria-hidden="true">
    <div class="brand-text">
      <span class="brand-laps">LAPS</span>
      <span class="brand-name">FileForge</span>
    </div>
  </div>
  <p class="privacy"><span class="dot" aria-hidden="true"></span><span>Everything stays on your device. No uploads, no internet connection.</span></p>
  <div class="top-controls" aria-label="App preferences">
    <button class="btn small" id="langToggle" type="button" title="Switch language">Deutsch</button>
    <button class="btn small" id="themeToggle" type="button" title="Switch theme">Dark mode</button>
  </div>
</header>

<main class="shell">
  <aside class="card source" aria-label="Quelle">
    <h2>Quelle</h2>
    <div class="drop" id="drop">
      <p>Ordner oder Dateien hierher ziehen</p>
      <div class="btn-row">
        <button class="btn primary" id="btnFolder" type="button">Ordner öffnen</button>
        <button class="btn" id="btnFiles" type="button">Dateien wählen</button>
      </div>
      <small id="dropHint">Die Dateien werden nur gelesen, nie hochgeladen.</small>
    </div>
    <input type="file" id="inFiles" multiple hidden>
    <input type="file" id="inFolder" webkitdirectory hidden>

    <div class="srcinfo">
      <div><span class="badge warn" id="srcBadge">Beispieldaten</span></div>
      <div class="srcname" id="srcName">Beispielordner</div>
      <div class="stats">
        <div class="stat"><b id="stFiles">0</b><span>Dateien</span></div>
        <div class="stat"><b id="stSize">0</b><span>Gesamtgröße</span></div>
      </div>
      <div class="btn-row">
        <button class="btn small" id="btnRescan" type="button">Neu einlesen</button>
        <button class="btn small" id="btnUndo" type="button">Rückgängig</button>
        <button class="btn small ghost" id="btnSample" type="button">Beispiel laden</button>
      </div>
    </div>

    <div class="opts">
      <label class="check"><input type="checkbox" id="optSub" checked> Unterordner einbeziehen</label>
      <label class="check"><input type="checkbox" id="optHidden" checked> Versteckte Dateien ausblenden</label>
      <label class="check"><input type="checkbox" id="optHeavy" checked> node_modules und .git überspringen (beim Einlesen)</label>
    </div>
    <p class="cap" id="capInfo"></p>
    <p class="muted" style="margin:0;font-size:12.5px">For whole-drive scans and Windows app activity, open <b>System scan</b>.</p>
  </aside>


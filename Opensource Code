}
async function moveFile(root, from, to) {
  const sd = await resolveDir(root, dirOf(from), false);
  const td = await resolveDir(root, dirOf(to), true);
  const sn = leafOf(from), tn = leafOf(to);
  if (await entryExists(td, tn)) throw new Error('Ziel existiert bereits: ' + to);
  const fh = await sd.getFileHandle(sn);
  if (typeof fh.move === 'function') {
    try {
      if (dirOf(from) === dirOf(to)) await fh.move(tn); else await fh.move(td, tn);
      return;
    } catch (e) { /* Browser unterstützt Verschieben hier nicht: weiter mit Kopieren */ }
  }
  const file = await fh.getFile();
  const nh = await td.getFileHandle(tn, { create: true });
  try {
    const w = await nh.createWritable();
    await file.stream().pipeTo(w);
    const check = await nh.getFile();
    if (check.size !== file.size) throw new Error('Kopie unvollständig: ' + to);
  } catch (e) {
    try { await td.removeEntry(tn); } catch (_) { /* ignorieren */ }
    throw e;
  }
  await sd.removeEntry(sn);
}
async function applyMoves(key, moves, label) {
  if (!moves.length || state.busy) return;
  const ok = await askConfirm(`${moves.length.toLocaleString(uiLocale())} Dateien ändern?`, `Sie werden ${label}. Die Dateien werden direkt in deinem Ordner geändert. Danach kannst du die Aktion über „Rückgängig“ zurücknehmen.`, 'Ja, ausführen');
  if (!ok) return;
  try {
    if (!(await ensureWrite(state.root))) { toast('Schreibzugriff wurde nicht erlaubt.'); return; }
  } catch (e) { toast('Schreibzugriff nicht möglich: ' + e.message); return; }
  state.busy = true; renderActive();
  const steps = orderMoves(moves);
  const done = [];
  let failed = false;
  try {
    for (let i = 0; i < steps.length; i++) {
      await moveFile(state.root, steps[i].from, steps[i].to);
      done.push(steps[i]);
      if (i % 5 === 0 || i === steps.length - 1) setProg(key, (i + 1) / steps.length);
      if (i % 25 === 0) await tick();
    }
    toast(`${moves.length.toLocaleString(uiLocale())} Dateien ${label}.`);
  } catch (e) {
    failed = true;
    toast(`Abgebrochen bei „${leafOf(steps[done.length].from)}“: ${e.message}`);
  }
  if (done.length) state.undo = { label, steps: done };
  setProg(key, null);
  state.busy = false;
  await loadFromRoot(state.root, true);
  if (failed) renderActive();
}
async function undoLast() {
  const u = state.undo;
  if (!u || !state.root || state.busy) return;
  const ok = await askConfirm('Letzte Aktion rückgängig machen?', `Die letzte Aktion (Dateien ${u.label}) wird zurückgenommen, ${u.steps.length.toLocaleString(uiLocale())} Schritte. Neu angelegte, dann leere Ordner bleiben bestehen.`, 'Rückgängig machen');
  if (!ok) return;
  try { if (!(await ensureWrite(state.root))) { toast('Schreibzugriff wurde nicht erlaubt.'); return; } }
  catch (e) { toast('Schreibzugriff nicht möglich: ' + e.message); return; }
  state.busy = true; renderActive();
  let n = 0;
  try {
    for (let i = u.steps.length - 1; i >= 0; i--) {
      await moveFile(state.root, u.steps[i].to, u.steps[i].from);
      n++;
      if (n % 5 === 0) await tick();
    }
    state.undo = null;
    toast('Zurückgenommen.');
  } catch (e) {
    u.steps = u.steps.slice(0, u.steps.length - n);
    toast('Rückgängig abgebrochen: ' + e.message);
  }
  state.busy = false;
  await loadFromRoot(state.root, true);
}
async function zipAndSave(key, items, fileName) {
  if (state.busy) return;
  state.busy = true; renderActive();
  try {
    const blob = await buildZip(items, (i, n) => { if (i % 10 === 0 || i === n) setProg(key, i / n); });
    if (await saveBlob(blob, fileName)) toast('ZIP gespeichert: ' + fileName);
  } catch (e) { toast(e.message); }
  setProg(key, null);
  state.busy = false; renderActive();
}


<script>
"use strict";
let currentLanguage = 'en';
const uiLocale = () => currentLanguage === 'de' ? 'de-DE' : 'en-US';
/* ===== Reine Logik (ohne Oberfläche) ===== */
const K = (p) => p.toLowerCase();
const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const p2 = (n) => String(n).padStart(2, '0');
let coll = new Intl.Collator('en', { numeric: true, sensitivity: 'base' });
const natCompare = (a, b) => coll.compare(a, b);

function splitName(name) {
  const i = name.lastIndexOf('.');
  if (i <= 0 || i === name.length - 1) return { base: name, ext: '' };
  return { base: name.slice(0, i), ext: name.slice(i + 1) };
}
function dirOf(path) { const i = path.lastIndexOf('/'); return i < 0 ? '' : path.slice(0, i); }
function leafOf(path) { return path.slice(path.lastIndexOf('/') + 1); }
function makeEntry(path, size, mtime, file, idx) {
  const name = leafOf(path);
  const { base, ext } = splitName(name);
  return { id: idx, idx, path, name, dir: dirOf(path), base, ext, size, mtime, file: file || null };
}
function formatBytes(n) {
  if (n < 1024) return n.toLocaleString(uiLocale()) + ' B';
  const u = ['KB', 'MB', 'GB', 'TB'];
  let v = n / 1024, i = 0;
  while (v >= 1024 && i < u.length - 1) { v /= 1024; i++; }
  return v.toLocaleString(uiLocale(), { maximumFractionDigits: v < 10 ? 2 : 1 }) + ' ' + u[i];
}
function dateParts(ms) {
  const d = new Date(ms);
  return { y: String(d.getFullYear()), m: p2(d.getMonth() + 1), d: p2(d.getDate()), H: p2(d.getHours()), M: p2(d.getMinutes()), S: p2(d.getSeconds()) };
}
function fmtDate(ms) { const t = dateParts(ms); return `${t.y}-${t.m}-${t.d} ${t.H}:${t.M}`; }

const RESERVED = /^(con|prn|aux|nul|com[1-9]|lpt[1-9])(\..*)?$/i;
function validateName(n) {
  if (!n || !n.trim()) return 'Name ist leer';
  if (n === '.' || n === '..') return 'Name nicht erlaubt';
